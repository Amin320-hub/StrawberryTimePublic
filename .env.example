# Copia este fichero como ".env" y rellena los valores
# cp .env.example .env

# Base de datos
MYSQL_ROOT_PASSWORD=pon_aqui_una_contrasena_segura
MYSQL_DATABASE=fichadordb

# Usuario de la app
DB_USER=fichador_app
DB_PASSWORD=Contrasena_base_de_datos

# Clave JWT (larga y aleatoria)
JWT_SECRET=pon_aqui_una_clave_larga_y_aleatoria

# Clave AES-256 para cifrar credenciales SMTP — debe tener EXACTAMENTE 32 caracteres
ENCRYPTION_KEY=12345678901234567890123456789012

# Clave para firmar los tokens QR rotatorios
QR_SECRET=pon_aqui_otra_clave_aleatoria

# Contrasena del rol PC (pantalla del ordenador central)
PC_PASSWORD=pon_aqui_la_contrasena_del_pc
